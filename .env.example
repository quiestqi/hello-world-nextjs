NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
GEMINI_API_KEY=YOUR_SERVER_ONLY_GEMINI_KEY
GEMINI_MODEL=gemini-flash-lite-latest

# Optional Gemini native image model. Requires image-generation quota.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Free text-model design rendered as vector artwork (default).
# Set to image only when paid native image-model quota is available.
GEMINI_MAP_MODE=vector
